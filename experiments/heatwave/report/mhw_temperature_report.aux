\@writefile{toc}{\contentsline {section}{\numberline {1}Blob Template Analysis}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}Temporal Structure}{1}{subsection.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Pacific Blob anomaly template.} Monthly SST anomalies (vs.\ 2002--2012 climatology) for 2014, 2015, and 2016, averaged by region and ordered south to north. The Blob intensified through 2014, peaked in 2015 with anomalies exceeding +2--3$^\circ $C in Alaska, and dissipated through 2016. Note the persistent positive anomalies across all regions and months, with strongest warming in summer--fall.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:blob_template}{{1}{2}{\textbf {Pacific Blob anomaly template.} Monthly SST anomalies (vs.\ 2002--2012 climatology) for 2014, 2015, and 2016, averaged by region and ordered south to north. The Blob intensified through 2014, peaked in 2015 with anomalies exceeding +2--3$^\circ $C in Alaska, and dissipated through 2016. Note the persistent positive anomalies across all regions and months, with strongest warming in summer--fall}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Spatial Gradient}{2}{subsection.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Latitudinal gradient of peak Blob anomaly (2015).} Each point represents one of 896 monitoring sites, colored by anomaly magnitude. The gradient shows stronger warming at higher latitudes (50--60$^\circ $N), with the Salish Sea sites (48--49$^\circ $N) showing notably reduced anomalies relative to their latitude. This spatial heterogeneity is naturally preserved in all scenarios since we use the actual Blob fingerprint as the template.}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:blob_spatial}{{2}{2}{\textbf {Latitudinal gradient of peak Blob anomaly (2015).} Each point represents one of 896 monitoring sites, colored by anomaly magnitude. The gradient shows stronger warming at higher latitudes (50--60$^\circ $N), with the Salish Sea sites (48--49$^\circ $N) showing notably reduced anomalies relative to their latitude. This spatial heterogeneity is naturally preserved in all scenarios since we use the actual Blob fingerprint as the template}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Scenario Design}{3}{section.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Summary of 12 marine heatwave SST scenarios.}}{3}{table.caption.4}\protected@file@percent }
\newlabel{tab:scenarios}{{1}{3}{Summary of 12 marine heatwave SST scenarios}{table.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}All Scenarios at a Glance}{4}{subsection.2.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Marine heatwave scenario comparison (hero figure).} Each panel shows the regional mean SST anomaly (vs.\ 2002--2012 climatology) for one scenario, with regions ordered south to north (y-axis) and time on the x-axis (2025--2050). Red indicates warming above climatology. The Control panel (top left) shows zero anomaly by construction. Recurring scenarios show periodic warming pulses; the Chronic scenario shows uniform +1$^\circ $C; the Compound scenario shows overlapping events with no recovery period. All panels share the same color scale for direct comparison.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:scenario_comparison}{{3}{4}{\textbf {Marine heatwave scenario comparison (hero figure).} Each panel shows the regional mean SST anomaly (vs.\ 2002--2012 climatology) for one scenario, with regions ordered south to north (y-axis) and time on the x-axis (2025--2050). Red indicates warming above climatology. The Control panel (top left) shows zero anomaly by construction. Recurring scenarios show periodic warming pulses; the Chronic scenario shows uniform +1$^\circ $C; the Compound scenario shows overlapping events with no recovery period. All panels share the same color scale for direct comparison}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Intensity Comparison}{5}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Single-event intensity comparison.} Three panels showing the same 2030 heatwave event at 0.5$\times $ (Low), 1.0$\times $ (Medium, Blob-equivalent), and 1.5$\times $ (High) intensity. The spatial pattern is identical across panels---only the magnitude scales. At 1.5$\times $, peak anomalies in Alaska exceed +3$^\circ $C.}}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:intensity}{{4}{5}{\textbf {Single-event intensity comparison.} Three panels showing the same 2030 heatwave event at 0.5$\times $ (Low), 1.0$\times $ (Medium, Blob-equivalent), and 1.5$\times $ (High) intensity. The spatial pattern is identical across panels---only the magnitude scales. At 1.5$\times $, peak anomalies in Alaska exceed +3$^\circ $C}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Frequency Comparison}{5}{subsection.2.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Recurrence frequency comparison.} Four panels showing heatwave events recurring every 10, 7, 5, and 3 years at 1.0$\times $ (Blob-equivalent) intensity. At 3-year recurrence, events overlap significantly since each event spans 24 months, leaving minimal recovery time between events.}}{5}{figure.caption.7}\protected@file@percent }
\newlabel{fig:frequency}{{5}{5}{\textbf {Recurrence frequency comparison.} Four panels showing heatwave events recurring every 10, 7, 5, and 3 years at 1.0$\times $ (Blob-equivalent) intensity. At 3-year recurrence, events overlap significantly since each event spans 24 months, leaving minimal recovery time between events}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Regional Detail}{6}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}SST Trajectories}{6}{subsection.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Regional mean SST time series (2012--2050).} Four representative regions (AK-PWS, JDF, OR, CA-S) under four scenarios. The vertical dashed line marks 2025, where synthetic SST begins. Pre-2025 trajectories are identical (original OISST data). Post-2025, the Control scenario uses flat climatology, while heatwave scenarios show characteristic warming pulses.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:timeseries}{{6}{6}{\textbf {Regional mean SST time series (2012--2050).} Four representative regions (AK-PWS, JDF, OR, CA-S) under four scenarios. The vertical dashed line marks 2025, where synthetic SST begins. Pre-2025 trajectories are identical (original OISST data). Post-2025, the Control scenario uses flat climatology, while heatwave scenarios show characteristic warming pulses}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Simulated vs.\ Real Blob}{7}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Peak anomaly comparison: real Blob (2015) vs.\ simulated event (MHW\_S1\_MED, 2030--2031).} The simulated event closely reproduces the real Blob's regional pattern, including the characteristic amplification in Alaska and buffering in the Salish Sea. Minor differences arise from the temporal compression (24-month lifecycle vs.\ the Blob's actual multi-year evolution).}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:peak_anomaly}{{7}{7}{\textbf {Peak anomaly comparison: real Blob (2015) vs.\ simulated event (MHW\_S1\_MED, 2030--2031).} The simulated event closely reproduces the real Blob's regional pattern, including the characteristic amplification in Alaska and buffering in the Salish Sea. Minor differences arise from the temporal compression (24-month lifecycle vs.\ the Blob's actual multi-year evolution)}{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Chronic vs.\ Pulsed Warming}{7}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Chronic vs.\ pulsed warming comparison.} Left: cumulative heat exposure over 2025--2050. The chronic +1$^\circ $C scenario accumulates heat steadily, while the pulsed scenario (5-year recurrence) shows stepwise increases during events. Right: annual mean anomaly showing the contrasting temporal patterns. Despite similar cumulative exposure, the ecological impact may differ---chronic warming allows adaptation, while pulsed events may overwhelm thermal tolerance.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:chronic_pulse}{{8}{7}{\textbf {Chronic vs.\ pulsed warming comparison.} Left: cumulative heat exposure over 2025--2050. The chronic +1$^\circ $C scenario accumulates heat steadily, while the pulsed scenario (5-year recurrence) shows stepwise increases during events. Right: annual mean anomaly showing the contrasting temporal patterns. Despite similar cumulative exposure, the ecological impact may differ---chronic warming allows adaptation, while pulsed events may overwhelm thermal tolerance}{figure.caption.10}{}}
